<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Select only the consumer target, not the TFM of referenced libraries. -->
    <TargetFramework Condition="'$(SmokeTargetFramework)' != ''">$(SmokeTargetFramework)</TargetFramework>
    <TargetFramework Condition="'$(SmokeTargetFramework)' == ''">net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <UseMaui>true</UseMaui>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120" />
    <ProjectReference Include="../../src/Laveyana.Maui.UI/Laveyana.Maui.UI.csproj" />
    <ProjectReference Include="../../src/Laveyana.Maui.UI.Windows/Laveyana.Maui.UI.Windows.csproj"
                      Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <ProjectReference Include="../../src/Laveyana.Maui.UI.Android/Laveyana.Maui.UI.Android.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'">
    <Compile Remove="AndroidSmokeConsumer.cs" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <Compile Remove="WindowsSmokeConsumer.cs" />
  </ItemGroup>
</Project>
